<body>
    <div class="dashboard-wrapper">
        {{>navbar-candidato}}
        <main class="main-content">
            <div class="categories modern-categories">
                <button id="catLeft" class="category-arrow left disabled">
                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="currentColor" viewBox="0 0 16 16">
                        <path d="M11 1.5a.5.5 0 0 1 .5.5v12a.5.5 0 0 1-1 0v-12a.5.5 0 0 1 .5-.5z"/>
                        <path d="M4.854 8.354a.5.5 0 0 1 0-.708l3-3a.5.5 0 1 1 .708.708L5.707 8l2.855 2.854a.5.5 0 1 1-.708.708l-3-3z"/>
                    </svg>
                </button>
                <div id="categoriesList" class="categories-list">
                    {{#each areas}}
                    <button class="category-chip" data-category="{{this}}">{{this}}</button>
                    {{/each}}
                </div>
                <button id="catRight" class="category-arrow right">
                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="currentColor" viewBox="0 0 16 16">
                        <path d="M5 1.5a.5.5 0 0 0-.5.5v12a.5.5 0 0 0 1 0v-12a.5.5 0 0 0-.5-.5z"/>
                        <path d="M11.146 8.354a.5.5 0 0 0 0-.708l-3-3a.5.5 0 1 0-.708.708L10.293 8l-2.855 2.854a.5.5 0 1 0 .708.708l3-3z"/>
                    </svg>
                </button>
            </div>
            <div class="jobs-feed">
                <ul class="card-grid">
                    {{#if vagas.length}}
                    {{#each vagas}}
                    <li id="card-job" class="job-card modern-job-card">
                        <img src="{{imagem}}" alt="{{nome}}" class="job-image" />
                        <h2>{{nome}}</h2>
                        {{#if empresa}}
                        <p class="job-company">{{empresa.nome}}</p>
                        {{/if}}
                        <p class="job-area">{{area}}</p>
                        <button class="register-button" onclick="window.location.href = '/candidato/vagas/{{_id}}';">Ver Vaga</button>
                    </li>
                    {{/each}}
                    {{else}}
                    <div class="no-data">
                        <p>Não existem vagas cadastradas.</p>
                    </div>
                    {{/if}}
                </ul>
            </div>
        </main>
    </div>
    {{> footer-candidato}}
    <script type="module" src="/assets/js/buscarVagas.js"></script>
</body>