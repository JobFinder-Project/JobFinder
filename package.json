{
  "name": "jobfinder",
  "version": "1.0.0",
  "description": "JobFinder - Plataforma de conexão entre candidatos e empresas",
  "private": true,
  "scripts": {
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "npm --prefix backend run dev",
    "dev:frontend": "npm --prefix frontend run dev",
    "build": "npm --prefix frontend run build",
    "test": "npm run test:backend",
    "test:backend": "npm --prefix backend test",
    "test:frontend": "npm --prefix frontend test",
    "test:all": "npm run test:backend && npm run test:frontend",
    "install:all": "npm install && npm --prefix backend install && npm --prefix frontend install",
    "start": "npm --prefix backend start"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JobFinder-Project/JobFinder.git"
  },
  "license": "MIT"
}
