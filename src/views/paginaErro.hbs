<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{title}}</title>
    <link rel="stylesheet" href="/css/{{style}}"> 
</head>
<body>

    <div class="error-container">
        <h1 class="error-status">{{status}}</h1>

        <h2 class="error-title">{{title}}</h2>

        <p class="error-message">{{mensagem}}</p>

        {{#if erro}}
            <div class="system-error">
                <strong>Detalhes técnicos:</strong> <br>
                {{erro}}
            </div>
        {{/if}}

        <a href="javascript:history.back()" class="btn-voltar">Voltar para a página anterior</a>
    </div>

</body>
</html>