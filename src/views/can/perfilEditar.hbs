<body>
    <div class="page-container">
        {{>navbar-candidato}}

        <!-- Conteúdo principal -->
        <main class="main-content">
            <h2>Editar Perfil</h2>

            <form class="form" action="/candidato/perfil/{{user._id}}/editar" method="POST" enctype="multipart/form-data">
                <!-- Foto de perfil -->
                <div class="form-group">
                    <label for="imagem">Imagem de Perfil:</label>
                    <input type="file" id="imagem" name="imagem">
                    {{#if user.imagem}}
                    <img src="{{user.imagem}}" alt="Imagem de perfil" class="profile-image">
                    {{/if}}
                </div>

                <!-- Informações pessoais -->
                <div class="form-group">
                    <label for="nome">Nome:</label>
                    <input type="text" id="nome" name="nome" value="{{user.nome}}" required>
                </div>

                <div class="form-group">
                    <label for="cpf">CPF:</label>
                    <input type="text" id="cpf" name="cpf" value="{{user.cpf}}" required>
                </div>

                <div class="form-group">
                    <label for="email">Email:</label>
                    <input type="email" id="email" name="email" value="{{user.email}}" required>
                </div>

                <div class="form-group">
                    <label for="telefone">Telefone:</label>
                    <input type="text" id="telefone" name="telefone" value="{{user.telefone}}" required>
                </div>

                <div class="form-group">
                    <label for="educacao">Educação:</label>
                    <input type="text" id="educacao" name="educacao" value="{{user.educacao}}" required>
                </div>

                <div class="form-group">
                    <label for="qualificacao">Qualificação:</label>
                    <input type="text" id="qualificacao" name="qualificacao" value="{{user.qualificacao}}">
                </div>

                <div class="form-group">
                    <label for="cursos">Cursos:</label>
                    <input type="text" id="cursos" name="cursos" value="{{user.cursos}}">
                </div>

                <div class="form-group">
                    <label for="habilidades">Habilidades Técnicas:</label>
                    <input type="text" id="habilidades" name="habilidades" value="{{user.habilidadesTecnicas}}">
                </div>

                <div class="form-group">
                    <label for="idiomas">Idiomas:</label>
                    <input type="text" id="idiomas" name="idiomas" value="{{user.idiomas}}">
                </div>

                <div class="form-group">
                    <label for="descricao">Descrição:</label>
                    <textarea id="descricao" name="descricao">{{user.descricao}}</textarea>
                </div>

                <!-- Botão para enviar -->
                <button type="submit" class="submit-button">Salvar alterações</button>
            </form>
            <button class="back-button"><a href="/candidato/dashboard">Voltar</a></button>
        </main>
    </div>
</body>
